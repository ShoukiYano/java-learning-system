# ==========================================
# Supabase 接続設定
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# アプリケーションURL設定
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# 管理者・企業ポータル ステルス保護＆多要素認証設定
# ==========================================
# ゲートキーがない状態で /admin/login や /company/login にアクセスされた場合は 404 Not Found に偽装します
# 例: /admin/login?gate=dss-admin-gate-2025 でアクセスすると承認Cookieがセットされてログイン画面が表示されます
ADMIN_GATE_KEY=dss-admin-gate-2025
COMPANY_GATE_KEY=dss-corp-gate-2025

# システム管理者ログイン時の必須セキュリティPINコード
ADMIN_MASTER_PIN=778899
